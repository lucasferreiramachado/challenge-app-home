<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ds="clr-namespace:DesignSystem;assembly=DesignSystem"
             xmlns:vm="clr-namespace:Home.Presentation"
             x:Class="Home.Presentation.HomeView"
             x:DataType="vm:HomeViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">
    <Grid
        HorizontalOptions="FillAndExpand"
        VerticalOptions="FillAndExpand"
        RowDefinitions="Auto, * , Auto"
        Margin="16, 24, 16, 24">
        <!-- Topo -->
        <ds:DsLabelBold Grid.Row="0"
                        Text="{Binding Username, StringFormat='Olá, {0}'}"
                        Margin="0, 16, 0, 0"
                        HorizontalOptions="Start" />

        <!-- Centro -->
        <VerticalStackLayout Grid.Row="1"
                             HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             Spacing="16">

            <ds:DsButton
                Text="Geração dinâmica de blocos"
                Command="{Binding GoToBlocksCommand}" />

            <ds:DsButton
                Text="Buscar de países via API"
                Command="{Binding GoToCountriesCommand}" />

        </VerticalStackLayout>

        <!-- Base (Bottom) -->
        <ds:DsLabelBold Grid.Row="2"
                        FontSize="12"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        Text="{Binding AppVersion, StringFormat='Versão {0}'}" />
    </Grid>
</ContentPage>